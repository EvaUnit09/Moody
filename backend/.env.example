# Required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_DB_URL=

# Optional — CORS origins for the deployed frontend (comma-separated).
# Defaults to localhost dev origins if unset.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional — Datadog APM + LLM Observability. Leave unset to disable tracing.
# DD_API_KEY=
# DD_SERVICE=movie-rec-backend
# DD_ENV=dev
# DD_VERSION=
# DD_SITE=datadoghq.com
# DD_LLMOBS_ML_APP=
# DD_TRACE_ENABLED=false
# DD_TRACE_AGENT_URL=
