# Required
SUPABASE_DB_URL=
TMDB_API_READ_TOKEN=  # TMDB API read access token

# Optional — Only needed for embedding generation and /recommend endpoint
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — CORS origins for the deployed frontend (comma-separated).
# ALLOWED_ORIGINS=https://www.moodyalpha.app

# Optional — asyncpg pool. Defaults are min=1 max=2. Cap the product
# replicas × workers × DB_POOL_MAX_SIZE across TEST, production, and ingest
# under the Supabase session pooler's 15 client slots (port 5432).
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=2
# DB_APPLICATION_NAME=moody

# Optional — Datadog APM + LLM Observability. Leave unset to disable tracing.
# DD_API_KEY=
# DD_SERVICE=movie-rec-backend
# DD_ENV=dev
# DD_VERSION=
# DD_SITE=datadoghq.com
# DD_LLMOBS_ML_APP=
# DD_TRACE_ENABLED=false
# DD_TRACE_AGENT_URL=
